        "roomKey": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Roomkey",
          "type": "string"
        },
        "widthMm": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Widthmm",
          "type": "number"
