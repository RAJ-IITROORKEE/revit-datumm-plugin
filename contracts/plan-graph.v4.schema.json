        "widthMm": {
          "maxLength": 24,
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Widthmm",
          "type": "string"
        },
        "depthMm": {
          "maxLength": 24,
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Depthmm",
          "type": "string"
        }
      },
      "required": [
        "role",
        "sourceText",
        "widthMm",
        "depthMm"
      ],
      "title": "DimensionSource",
      "type": "object"
    },
